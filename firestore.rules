rules_version = '2';
// Règles Firestore pour le Terminal de khôlle MP2I.
// ⚠️ Permissives (entre camarades). N'importe quel visiteur du site peut lire/écrire
//    la collection users. Suffisant pour une classe ; PAS pour des données sensibles.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{name} {
      allow read, write: if true;
    }
  }
}
